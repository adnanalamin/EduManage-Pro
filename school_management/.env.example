# EduManage Pro Database Configuration Example
# Copy to .env and customize for Enterprise/LAN PostgreSQL deployments.
# Default standalone mode uses local SQLite with WAL mode.

# Edition: sqlite (Standalone) | postgresql (LAN / Enterprise)
EDUMANAGE_DB_BACKEND=sqlite

# Optional explicit SQLAlchemy URL override:
# EDUMANAGE_DATABASE_URL=postgresql+psycopg://edumanage:change_me@192.168.1.10:5432/edumanage_pro

# PostgreSQL connection settings (used when EDUMANAGE_DB_BACKEND=postgresql and EDUMANAGE_DATABASE_URL is unset)
EDUMANAGE_PG_HOST=localhost
EDUMANAGE_PG_PORT=5432
EDUMANAGE_PG_DB=edumanage_pro
EDUMANAGE_PG_USER=edumanage
EDUMANAGE_PG_PASSWORD=

# Connection pool tuning (PostgreSQL)
EDUMANAGE_DB_POOL_SIZE=10
EDUMANAGE_DB_MAX_OVERFLOW=20
EDUMANAGE_DB_POOL_TIMEOUT=30
EDUMANAGE_DB_ECHO=false
